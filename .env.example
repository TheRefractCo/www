# GA4 measurement IDs are public browser identifiers, not secrets. Keeping them
# in environment configuration prevents them from being hard-coded in source.
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Optional: route /paper and its descendants to a different GA4 property.
GOOGLE_ANALYTICS_PAPER_ID=

# required: banner shown; Google stays unloaded until opt-in (default)
# not-required: no initial banner; analytics starts unless the visitor opts out
# off: analytics and the banner are disabled
ANALYTICS_CONSENT_MODE=required
