---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import '../styles/lightfield.css';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { defaultLang, localeMetadata, ui, type Locale } from '../i18n/ui';
import { getLangFromUrl, getRouteFromUrl, localeList, useTranslatedPath } from '../i18n/utils';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	noIndex?: boolean;
}

const locale = getLangFromUrl(Astro.url, Astro.currentLocale);
const route = getRouteFromUrl(Astro.url, Astro.currentLocale);
const localizedPath = useTranslatedPath(locale);
const canonicalPath = (path: string) => {
	const normalized = path.replace(/\/+$/, '');
	return normalized ? `${normalized}/` : '/';
};
const canonicalURL = new URL(canonicalPath(localizedPath(route, locale)), Astro.site);
const alternateUrl = (targetLocale: Locale) =>
	new URL(canonicalPath(localizedPath(route, targetLocale)), Astro.site);
const docsRoute = route.startsWith('paper/docs/') ? route.slice('paper/docs/'.length) : undefined;
const docsEntries = route === 'paper/docs' || docsRoute ? await getCollection('docs') : [];
const sourceDoc = docsRoute
	? docsEntries.find((entry) => entry.id === `${defaultLang}/${docsRoute}`)
	: undefined;
const isIndexableAlternate = (targetLocale: Locale) => {
	if (targetLocale === defaultLang) return true;
	if (route === 'paper') return Boolean(ui[targetLocale]);
	if (route === 'paper/docs') {
		return docsEntries.some((entry) => entry.id.startsWith(`${targetLocale}/`));
	}
	if (sourceDoc) {
		return docsEntries.some(
			(entry) => entry.id.startsWith(`${targetLocale}/`) && entry.data.docId === sourceDoc.data.docId,
		);
	}
	return false;
};
const alternateLocales = localeList.filter(isIndexableAlternate);

const { title, description, image, noIndex = false } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={new URL('favicon.svg', Astro.site)} />
<link rel="sitemap" href={new URL('sitemap-index.xml', Astro.site)} />
<link
	rel="alternate"
	type="application/rss+xml"
	title="Refract website RSS feed"
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
{noIndex && <meta name="robots" content="noindex,follow" />}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta property="og:locale" content={localeMetadata[locale]?.ogLocale ?? locale.replace('-', '_')} />

{alternateLocales.map((targetLocale) => (
	<link
		rel="alternate"
		hreflang={localeMetadata[targetLocale]?.hreflang ?? targetLocale}
		href={alternateUrl(targetLocale)}
	/>
))}
<link rel="alternate" hreflang="x-default" href={alternateUrl(defaultLang)} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image.src, Astro.url)} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
