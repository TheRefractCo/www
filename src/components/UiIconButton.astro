---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
	label: string;
	variant?: 'default' | 'inverse';
	className?: string;
}

const { label, variant = 'default', class: classAttribute, className, type = 'button', ...attributes } = Astro.props;
---

<button
	type={type}
	class:list={['ui-icon-button', `ui-icon-button--${variant}`, classAttribute, className]}
	aria-label={label}
	{...attributes}
>
	<slot />
</button>
