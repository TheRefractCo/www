---
import { Languages, X } from '@lucide/astro';
import { defaultLang, languages } from '../i18n/ui';
import { getLangFromUrl, getRouteFromUrl, localeList, useTranslatedPath, useTranslations } from '../i18n/utils';
import UiButton from './UiButton.astro';
import UiIconButton from './UiIconButton.astro';

const locale = getLangFromUrl(Astro.url, Astro.currentLocale);
const route = getRouteFromUrl(Astro.url, Astro.currentLocale);
const translatePath = useTranslatedPath(locale);
const t = useTranslations(locale);
const paths = Object.fromEntries(
	localeList.map((language) => [language, translatePath(route, language)]),
);
---

<dialog
	class="ui-dialog language-suggestion"
	data-language-suggestion
	data-current-locale={locale}
	data-default-locale={defaultLang}
	data-supported-locales={JSON.stringify(localeList)}
	data-language-labels={JSON.stringify(languages)}
	data-language-paths={JSON.stringify(paths)}
	aria-labelledby="language-suggestion-title"
	aria-describedby="language-suggestion-message"
>
	<div class="language-suggestion__header">
		<span class="language-suggestion__icon" aria-hidden="true"><Languages size={19} strokeWidth={1.8} /></span>
		<form method="dialog">
			<UiIconButton label={t('language.suggestion.close')} type="submit">
				<X size={18} strokeWidth={1.8} aria-hidden="true" />
			</UiIconButton>
		</form>
	</div>
	<p class="language-suggestion__eyebrow">{t('language.suggestion.eyebrow')}</p>
	<h2 id="language-suggestion-title">{t('language.suggestion.title')}</h2>
	<p id="language-suggestion-message">{t('language.suggestion.message')}</p>
	<div class="language-suggestion__actions">
		<UiButton className="language-suggestion__switch" variant="primary" data-language-suggestion-link href={paths[defaultLang]}>
			<span>{t('language.suggestion.switch')}</span>
			<strong data-language-suggestion-target>{languages[defaultLang]}</strong>
			<span aria-hidden="true">→</span>
		</UiButton>
		<UiButton className="language-suggestion__dismiss" variant="secondary" data-language-suggestion-dismiss>
			{t('language.suggestion.dismiss')}
		</UiButton>
	</div>
</dialog>

<script>
	const suggestionPreferenceKey = 'refract.locale-preference.v1';
	const suggestionDismissedKey = 'refract.locale-suggestion-dismissed.v1';

	const getStorageValue = (key: string) => {
		try {
			return localStorage.getItem(key);
		} catch {
			return null;
		}
	};

	const setStorageValue = (key: string, value: string) => {
		try {
			localStorage.setItem(key, value);
		} catch {
			// The suggestion remains usable when storage is unavailable.
		}
	};

	const getBrowserLocale = (supportedLocales: string[]) => {
		const requestedLocales = navigator.languages?.length ? navigator.languages : [navigator.language];
		return requestedLocales
			.map((requested) => requested.toLowerCase())
			.map((requested) => supportedLocales.find((supported) =>
				supported.toLowerCase() === requested || requested.startsWith(`${supported.toLowerCase()}-`),
			))
			.find((match): match is string => Boolean(match));
	};

	const setupLanguageSuggestion = () => {
		const dialog = document.querySelector<HTMLDialogElement>('[data-language-suggestion]');
		if (!dialog || dialog.dataset.ready === 'true') return;
		dialog.dataset.ready = 'true';

		const currentLocale = dialog.dataset.currentLocale ?? dialog.dataset.defaultLocale ?? '';
		const supportedLocales = JSON.parse(dialog.dataset.supportedLocales ?? '[]') as string[];
		const labels = JSON.parse(dialog.dataset.languageLabels ?? '{}') as Record<string, string>;
		const paths = JSON.parse(dialog.dataset.languagePaths ?? '{}') as Record<string, string>;
		const targetLink = dialog.querySelector<HTMLAnchorElement>('[data-language-suggestion-link]');
		const targetLabel = dialog.querySelector<HTMLElement>('[data-language-suggestion-target]');
		const dismissButton = dialog.querySelector<HTMLButtonElement>('[data-language-suggestion-dismiss]');

		const detectedLocale = getBrowserLocale(supportedLocales);
		dismissButton?.addEventListener('click', () => {
			if (detectedLocale) setStorageValue(suggestionDismissedKey, detectedLocale);
			dialog.close();
		});

		const explicitPreference = getStorageValue(suggestionPreferenceKey);
		const dismissedLocale = getStorageValue(suggestionDismissedKey);
		if (
			!detectedLocale ||
			detectedLocale === currentLocale ||
			explicitPreference ||
			dismissedLocale === detectedLocale ||
			dialog.dataset.currentLocale !== dialog.dataset.defaultLocale
		) {
			return;
		}

		if (targetLink && paths[detectedLocale]) targetLink.href = paths[detectedLocale];
		if (targetLabel) targetLabel.textContent = labels[detectedLocale] ?? detectedLocale;

		targetLink?.addEventListener('click', () => setStorageValue(suggestionPreferenceKey, detectedLocale));
		window.setTimeout(() => {
			if (!dialog.open) dialog.showModal();
		}, 450);
	};

	const windowWithLanguageSuggestionSetup = window as Window & { refractLanguageSuggestionSetup?: boolean };
	if (!windowWithLanguageSuggestionSetup.refractLanguageSuggestionSetup) {
		document.addEventListener('astro:page-load', setupLanguageSuggestion);
		windowWithLanguageSuggestionSetup.refractLanguageSuggestionSetup = true;
	}
	setupLanguageSuggestion();
</script>
