---
import { analyticsConfig } from '../config/analytics';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '../i18n/utils';

const locale = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(locale);
const localizedHref = useTranslatedPath(locale);

const clientConfig = {
	consentMode: analyticsConfig.consentMode,
	consentStorageKey: analyticsConfig.consentStorageKey,
	manualPageViews: analyticsConfig.measurements.length > 1,
	measurements: analyticsConfig.measurements,
};
---

{
	analyticsConfig.enabled && (
		<>
			<script
				id="refract-analytics-config"
				type="application/json"
				is:inline
				set:html={JSON.stringify(clientConfig)}
			></script>

			<aside
				class="analytics-consent"
				data-analytics-consent
				aria-labelledby="analytics-consent-title"
				hidden
			>
				<div class="analytics-consent__copy">
					<p class="analytics-consent__eyebrow">{t('analytics.eyebrow')}</p>
					<h2 id="analytics-consent-title">{t('analytics.title')}</h2>
					<p data-analytics-consent-message>
						{t('analytics.message')} <a href={`${localizedHref('privacy')}#website-analytics`}>
							{t('analytics.privacy')}
						</a>
					</p>
				</div>
				<div class="analytics-consent__actions">
					<button type="button" data-analytics-choice="granted">{t('analytics.allow')}</button>
					<button type="button" data-analytics-choice="denied">{t('analytics.deny')}</button>
				</div>
			</aside>

			<script>
				import '../scripts/analytics';
			</script>
		</>
	)
}
