---
import { Image } from 'astro:assets';
import paperAnnotate from '../assets/projects/paper/paper-annotate.png';
import paperLibrary from '../assets/projects/paper/paper-library.png';
import paperOverview from '../assets/projects/paper/paper-overview.png';
import paperRoadmap from '../assets/projects/paper/paper-roadmap.png';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import SnapCarousel from './SnapCarousel.astro';

interface Props {
	title?: string;
	className?: string;
}

const locale = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(locale);
const { title = t('paper.carousel.title'), className } = Astro.props;
const screenshots = [
	{
		src: paperOverview,
		alt: t('paper.carousel.overviewAlt'),
		caption: t('paper.carousel.overviewCaption'),
	},
	{
		src: paperLibrary,
		alt: t('paper.carousel.libraryAlt'),
		caption: t('paper.carousel.libraryCaption'),
	},
	{
		src: paperAnnotate,
		alt: t('paper.ink.imageAlt'),
		caption: t('paper.carousel.annotateCaption'),
	},
	{
		src: paperRoadmap,
		alt: t('paper.carousel.roadmapAlt'),
		caption: t('paper.carousel.roadmapCaption'),
	},
];
---

<SnapCarousel title={title} label={t('paper.carousel.label')} className={className}>
	{
		screenshots.map((screenshot) => (
			<figure class="paper-screenshot">
				<Image
					src={screenshot.src}
					alt={screenshot.alt}
					loading="lazy"
					quality={88}
				/>
				<figcaption>{screenshot.caption}</figcaption>
			</figure>
		))
	}
</SnapCarousel>
