---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
	href?: string;
	variant?: 'primary' | 'secondary' | 'quiet' | 'inverse' | 'outline-inverse' | 'danger';
	size?: 'regular' | 'small';
	className?: string;
}

const {
	href,
	variant = 'primary',
	size = 'regular',
	class: classAttribute,
	className,
	type = 'button',
	...attributes
} = Astro.props;

const classes = ['ui-button', `ui-button--${variant}`, `ui-button--${size}`, classAttribute, className];
---

{
	href ? (
		<a href={href} class:list={classes} {...attributes}>
			<slot />
		</a>
	) : (
		<button type={type} class:list={classes} {...attributes}>
			<slot />
		</button>
	)
}
