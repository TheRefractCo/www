---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
	href: string;
	className?: string;
}

const { href, class: classAttribute, className, ...attributes } = Astro.props;
---

<a href={href} class:list={['ui-text-link', classAttribute, className]} {...attributes}>
	<slot />
</a>
