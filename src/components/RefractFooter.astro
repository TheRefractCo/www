---
import refractWordmark from '../assets/brand/refract-wordmark-white.svg';
import SocialLinks from './SocialLinks.astro';

interface Props {
	variant?: 'default' | 'compact';
}

const today = new Date();
const { variant = 'default' } = Astro.props;
---

<footer class:list={['site-footer', `site-footer--${variant}`]}>
	<div class="site-footer__inner">
		{variant === 'default' && <SocialLinks className="footer-social" />}

		<div class="footer-directory">
			<div class="footer-intro">
				<img src={refractWordmark.src} alt="Refract" />
				<p>Thoughtful software, made independently and with care.</p>
			</div>

			<nav class="footer-nav" aria-label="Footer navigation">
				<section>
					<h2>Explore</h2>
					<a href="/projects/">Projects</a>
					<a href="/paper/">Paper</a>
					<a href="/blog/">Blog</a>
				</section>
				<section>
					<h2>Company</h2>
					<a href="/about/">About</a>
					<a href="/contact/">Contact</a>
					<a href="/privacy/">Privacy</a>
					<button class="analytics-settings" type="button" data-analytics-settings hidden>
						Analytics choices
					</button>
				</section>
				<section>
					<h2>Site</h2>
					<a href="/sitemap-index.xml">Sitemap</a>
					<a href="/robots.txt">Robots.txt</a>
					<a href="/rss.xml">RSS feed</a>
				</section>
			</nav>
		</div>

		<div class="footer-bottom">
			<span>&copy; {today.getFullYear()} The Refract Co.</span>
			<span>Independent since 2023.</span>
		</div>
	</div>
</footer>
