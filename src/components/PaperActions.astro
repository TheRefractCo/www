---
import { getLangFromUrl, useTranslatedPath, useTranslations } from '../i18n/utils';
import { localeMetadata } from '../i18n/ui';

interface Props {
	campaign: string;
	thirdHref?: string;
	thirdLabel?: string;
	loadScript?: boolean;
}

const {
	campaign,
	thirdHref,
	thirdLabel,
	loadScript = true,
} = Astro.props;

const locale = getLangFromUrl(Astro.url, Astro.currentLocale);
const localizedHref = useTranslatedPath(locale);
const t = useTranslations(locale);
const resolvedThirdLabel = thirdLabel ?? t('paper.actions.learnMore');
const resolvedThirdHref = thirdHref ?? localizedHref('paper');
const storeUrl = `https://apps.microsoft.com/detail/9pjkn3wdpm1b?cid=${encodeURIComponent(campaign)}`;
---

<div class="paper-actions">
	<ms-store-badge
		productid="9pjkn3wdpm1b"
		cid={campaign}
		productname="Paper — PDFs, Books & News"
		window-mode="direct"
		theme="auto"
		size="small"
		language={localeMetadata[locale]?.storeLocale ?? locale.toLowerCase()}
		animation="on"
		data-analytics-event="paper_store_click"
		data-analytics-action="store_badge"
		data-analytics-location={campaign}
	>
	</ms-store-badge>
	<noscript>
		<a
			class="round-action round-action--store-fallback"
			href={storeUrl}
			data-analytics-event="paper_store_click"
			data-analytics-action="store_fallback"
			data-analytics-location={campaign}
		>
			{t('paper.actions.storeFallback')} <span aria-hidden="true">↗</span>
		</a>
	</noscript>
	<a
		class="round-action round-action--quiet"
		href={storeUrl}
		data-analytics-event="paper_store_click"
		data-analytics-action="store_link"
		data-analytics-location={campaign}
	>
		{t('paper.actions.store')} <span aria-hidden="true">↗</span>
	</a>
	<a
		class="round-action round-action--paper"
		href={resolvedThirdHref}
		data-analytics-event="paper_detail_click"
		data-analytics-action={resolvedThirdLabel}
		data-analytics-location={campaign}
	>
		{resolvedThirdLabel} <span aria-hidden="true">→</span>
	</a>
</div>

{
	loadScript && (
		<script
			type="module"
			src="https://get.microsoft.com/badge/ms-store-badge.bundled.js"
			is:inline
		></script>
	)
}
