---
import { Image } from 'astro:assets';
import paperWordmark from '../assets/brand/paper-wordmark.svg';
import paperOverview from '../assets/projects/paper/paper-overview.png';
import LightFieldHero from '../components/LightFieldHero.astro';
import PaperActions from '../components/PaperActions.astro';
import RefractBaseLayout from '../layouts/RefractBaseLayout.astro';
import UiTextLink from '../components/UiTextLink.astro';
import { defaultLang } from '../i18n/ui';
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';
import '../styles/product-pages.css';

const locale = getLangFromUrl(Astro.url, Astro.currentLocale);
const localizedHref = useTranslatedPath(locale);
---

<RefractBaseLayout
	title="The Refract Co. | Thoughtful software"
	description="The Refract Co. creates thoughtful, well-designed apps, tools, and digital experiences."
	pageClass="wide-page home-shell"
	noIndex={locale !== defaultLang}
>
	<div class="home-page">
		<LightFieldHero
			className="home-hero"
			primary="var(--color-cyan-400)"
			secondary="var(--color-violet-400)"
			verticalAlign="center"
			labelledBy="home-title"
		>
			<div class="home-hero__content">
				<h1 id="home-title">Thoughtful software,<br />made to feel at home.</h1>
				<p class="home-hero__lead">
					Refract creates carefully designed apps and digital experiences that stay useful,
					pleasant, and respectful of your attention.
				</p>
				<div class="home-hero__links">
					<UiTextLink href={localizedHref('about')}>About Refract <span aria-hidden="true">→</span></UiTextLink>
					<UiTextLink href={localizedHref('blog')}>Read the blog <span aria-hidden="true">→</span></UiTextLink>
				</div>
			</div>

			<a slot="overlay" class="scroll-cue" href="#projects-preview" aria-label="Scroll to featured projects">
				<span>See what we make</span>
				<b aria-hidden="true">↓</b>
			</a>
		</LightFieldHero>

		<section id="projects-preview" class="home-projects" aria-labelledby="home-projects-title">
			<header class="home-projects__header">
				<div>
					<p class="product-kicker">Selected projects</p>
					<h2 id="home-projects-title">Made with care.<br />Kept intentionally small.</h2>
				</div>
				<UiTextLink href={localizedHref('projects')}>All projects <span aria-hidden="true">→</span></UiTextLink>
			</header>

			<article class="home-project home-project--paper">
				<div class="home-project__copy">
					<img class="home-project__paper-logo" src={paperWordmark.src} alt="Paper" />
					<p>A calm, native Windows home for your PDFs, e-books, notes, and annotations.</p>
					<PaperActions campaign="rf-site-home" />
				</div>
				<div class="home-project__visual">
					<Image
						src={paperOverview}
						alt="Paper’s library, reader, notes, and document formats on Windows"
						loading="lazy"
						quality={84}
					/>
				</div>
			</article>

			<article class="home-project home-project--site">
				<div class="home-project__copy">
					<p class="product-kicker">This website</p>
					<h3>A quieter home on the web.</h3>
					<p>Fast, static, and focused on the work—with no accounts and only optional, consent-based analytics.</p>
					<UiTextLink className="home-project__link" href={`${localizedHref('projects')}#refract-website`}>
						How it was made <span aria-hidden="true">→</span>
					</UiTextLink>
				</div>
				<div class="home-site-preview" aria-hidden="true">
					<span>refract.fyi</span>
					<strong>The Refract Co.</strong>
					<i></i><i></i><i></i>
				</div>
			</article>
		</section>
	</div>
</RefractBaseLayout>
