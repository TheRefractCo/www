---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { defaultLang } from '../../../i18n/ui';
import { getDocRouteId, getLangFromUrl, useTranslatedPath } from '../../../i18n/utils';
import PaperDocsShell from '../../../components/PaperDocsShell.astro';
import RefractBaseLayout from '../../../layouts/RefractBaseLayout.astro';

export async function getStaticPaths() {
	const allEntries = await getCollection('docs');
	const sourceEntries = allEntries.filter((entry) => entry.id.startsWith(`${defaultLang}/`));
	const entries = sourceEntries.map((entry) => ({
		id: getDocRouteId(entry.id, defaultLang),
		docId: entry.data.docId,
		data: entry.data,
	}));

	return sourceEntries.map((entry) => ({
		params: { slug: getDocRouteId(entry.id, defaultLang) },
		props: { entry, entries },
	}));
}

interface Props {
	entry: CollectionEntry<'docs'>;
	entries: {
		id: string;
		docId: string;
		data: CollectionEntry<'docs'>['data'];
	}[];
}

const { entry, entries } = Astro.props;
const { Content } = await render(entry);
const entryId = getDocRouteId(entry.id, defaultLang);
const categoryRoot = entryId.split('/')[0];
const locale = getLangFromUrl(Astro.url, Astro.currentLocale);
const localizedHref = useTranslatedPath(locale);
---

<RefractBaseLayout
	title={`${entry.data.title} | Paper docs`}
	description={entry.data.description}
	pageClass="wide-page paper-shell paper-docs-shell"
	noIndex={locale !== defaultLang}
>
	<PaperDocsShell entries={entries} currentId={entryId} locale={locale}>
		<article id={entry.data.docId} data-doc-id={entry.data.docId} class="paper-docs__article">
			<header class="paper-docs__article-header">
				<p class="paper-docs__breadcrumb">
					<a href={localizedHref('paper/docs')}>Paper docs</a>
					<span aria-hidden="true">/</span>
					<a href={localizedHref(`paper/docs/${categoryRoot}`)}>{entry.data.category}</a>
				</p>
				<h1>{entry.data.title}</h1>
				<p>{entry.data.description}</p>
			</header>
			<div class="paper-docs__content">
				<Content />
			</div>
		</article>
	</PaperDocsShell>
</RefractBaseLayout>
