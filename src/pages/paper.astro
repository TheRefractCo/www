---
import { Image } from 'astro:assets';
import {
	BookOpen,
	FileText,
	Library,
	LockKeyhole,
	Monitor,
	Newspaper,
	NotebookPen,
	PenTool,
	Share2,
	Sparkles,
} from '@lucide/astro';
import paperWordmark from '../assets/brand/paper-wordmark.svg';
import paperAnnotate from '../assets/projects/paper/paper-annotate.png';
import paperOverview from '../assets/projects/paper/paper-overview.png';
import PaperActions from '../components/PaperActions.astro';
import PaperScreenshotRail from '../components/PaperScreenshotRail.astro';
import RefractBaseLayout from '../layouts/RefractBaseLayout.astro';
import '../styles/product-pages.css';
---

<RefractBaseLayout
	title="Paper | PDFs, books, and notes for Windows"
	description="Meet Paper, a thoughtful native Windows reading app for PDFs, e-books, notes, and Windows Ink annotations."
	pageClass="wide-page paper-shell"
>
	<div class="paper-page">
		<section class="paper-hero" aria-labelledby="paper-title">
			<div class="paper-hero__copy">
				<img class="paper-hero__logo" src={paperWordmark.src} alt="Paper" />
				<p class="paper-kicker">Made for Windows</p>
				<h1 id="paper-title">Make room<br />for reading.</h1>
				<p class="paper-hero__lead">
					Paper gathers the documents you read and the thoughts you add to them into one warm,
					native place—so your library feels personal again.
				</p>
				<PaperActions
					campaign="rf-site-paper"
					thirdHref="#features"
					thirdLabel="Explore features"
				/>
			</div>
			<div class="paper-hero__visual">
				<Image
					src={paperOverview}
					alt="Paper for Windows, showing its library, reader, notes, and document formats"
					loading="eager"
					quality={90}
				/>
			</div>
		</section>

		<section class="paper-promise" aria-label="Paper highlights">
			<p><span aria-hidden="true"><Library /></span><strong>One library</strong> for PDFs and e-books</p>
			<p><span aria-hidden="true"><PenTool /></span><strong>Natural ink</strong> with pen, pencil, and highlighter</p>
			<p><span aria-hidden="true"><Monitor /></span><strong>At home on Windows</strong> from the first click</p>
		</section>

		<section id="features" class="paper-features" aria-labelledby="paper-features-title">
			<header class="paper-section-heading">
				<p class="paper-kicker">Inside Paper</p>
				<h2 id="paper-features-title">A calmer way to read,<br />write, and keep what matters.</h2>
			</header>

			<div class="paper-feature-surface">
				<article>
					<span class="paper-feature__icon" aria-hidden="true"><FileText /></span>
					<h3>A focused PDF reader</h3>
					<p>Open documents in a calm reader designed around the page—not browser chrome.</p>
				</article>
				<article>
					<span class="paper-feature__icon" aria-hidden="true"><PenTool /></span>
					<h3>Write naturally</h3>
					<p>Annotate with Windows Ink using a pen, pencil, highlighter, eraser, and ruler.</p>
				</article>
				<article>
					<span class="paper-feature__icon" aria-hidden="true"><BookOpen /></span>
					<h3>Bring your e-books</h3>
					<p>Import EPUB books alongside PDFs instead of splitting your reading between apps.</p>
				</article>
				<article>
					<span class="paper-feature__icon" aria-hidden="true"><NotebookPen /></span>
					<h3>Keep a notebook</h3>
					<p>Capture ideas and reading notes without breaking the thread of what you are reading.</p>
				</article>
				<article>
					<span class="paper-feature__icon" aria-hidden="true"><Share2 /></span>
					<h3>Share what matters</h3>
					<p>Take annotated PDFs beyond Paper when a thought is ready to leave your library.</p>
				</article>
				<article>
					<span class="paper-feature__icon" aria-hidden="true"><Monitor /></span>
					<h3>Built for your PC</h3>
					<p>A native Windows experience made for mouse, keyboard, touch, and pen.</p>
				</article>
			</div>
		</section>

		<section class="paper-ink-story">
			<div class="paper-ink-story__copy">
				<p class="paper-kicker">Windows Ink</p>
				<h2>Your handwriting belongs on the page.</h2>
				<p>
					Underline the sentence. Circle the detail. Leave a question in the margin. Paper is built
					for the familiar gestures that make a document feel understood.
				</p>
			</div>
			<div class="paper-ink-story__visual">
				<Image src={paperAnnotate} alt="A handwritten annotation on a PDF in Paper" loading="lazy" quality={88} />
			</div>
		</section>

		<PaperScreenshotRail title="Turn a few pages" className="paper-page-carousel" />

		<section class="paper-roadmap" aria-labelledby="paper-roadmap-title">
			<header class="paper-section-heading">
				<p class="paper-kicker">The next chapter</p>
				<h2 id="paper-roadmap-title">Coming to Paper.</h2>
				<p>Features in active planning are kept separate from what you can use today.</p>
			</header>
			<div class="paper-roadmap__items">
				<article>
					<span aria-hidden="true"><Sparkles /></span>
					<div><h3>AI summaries</h3><p>Explore and understand your library with helpful, optional intelligence.</p></div>
					<small>Coming soon</small>
				</article>
				<article>
					<span aria-hidden="true"><LockKeyhole /></span>
					<div><h3>Windows Hello lock</h3><p>Put an extra layer of protection around your personal library.</p></div>
					<small>Coming soon</small>
				</article>
				<article>
					<span aria-hidden="true"><Newspaper /></span>
					<div><h3>News and articles</h3><p>Keep longer reads beside your books and documents.</p></div>
					<small>Coming soon</small>
				</article>
			</div>
		</section>

		<section class="paper-closing">
			<p class="paper-kicker">Ready when you are</p>
			<h2>There is always room<br />for one more good read.</h2>
			<PaperActions
				campaign="rf-site-paper"
				thirdHref="/privacy/#paper-policy"
				thirdLabel="Paper privacy"
				loadScript={false}
			/>
		</section>
	</div>
</RefractBaseLayout>
