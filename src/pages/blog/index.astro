---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import RefractBaseLayout from '../../layouts/RefractBaseLayout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<RefractBaseLayout title="Blog | Refract website" description="The Refract website blog.">
	<h1>Blog</h1>
	<p><a href="/rss.xml">Subscribe to the RSS feed</a></p>
	<ul>
		{
			posts.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>
						{post.data.heroImage && (
							<Image width={720} height={360} src={post.data.heroImage} alt="" />
						)}
						<h2>{post.data.title}</h2>
						<p><FormattedDate date={post.data.pubDate} /></p>
					</a>
				</li>
			))
		}
	</ul>
</RefractBaseLayout>
