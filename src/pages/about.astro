---
import SocialLinks from '../components/SocialLinks.astro';
import LightFieldHero from '../components/LightFieldHero.astro';
import RefractBaseLayout from '../layouts/RefractBaseLayout.astro';
import { defaultLang } from '../i18n/ui';
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';
import '../styles/info-pages.css';

const locale = getLangFromUrl(Astro.url, Astro.currentLocale);
const localizedHref = useTranslatedPath(locale);
---

<RefractBaseLayout
	title="About | The Refract Co."
	description="The Refract Co. is an independent product brand making smart, helpful, and well-crafted experiences."
	pageClass="about-shell"
	footerVariant="compact"
	noIndex={locale !== defaultLang}
>
	<div class="info-page about-page">
		<LightFieldHero
			className="info-hero info-hero--about"
			primary="#c0ff70"
			secondary="#5fd3ff"
			labelledBy="about-title"
		>
			<p class="eyebrow">About</p>
			<h1 id="about-title">Small by choice.<br />Thoughtful by default.</h1>
			<p class="info-hero__lead">
				The Refract Co. is an independent product brand making useful software with
				care, clarity, and respect for the people using it.
			</p>
		</LightFieldHero>

		<section class="about-story" aria-labelledby="about-story-title">
			<div>
				<p class="eyebrow">Our story</p>
				<h2 id="about-story-title">Independent since 2023.</h2>
			</div>
			<div class="about-story__copy">
				<p>
					Refract is currently run by one person, making apps, tools, and digital
					experiences that aim to be genuinely helpful and pleasant to use.
				</p>
				<p>
					We care about the small details, keep privacy in the foundation, and choose
					calm, focused design over noise.
				</p>
				<a class="info-cta" href={localizedHref('contact')}>Get in touch <span aria-hidden="true">→</span></a>
			</div>
		</section>

		<section class="page-social-panel" aria-labelledby="about-social-title">
			<div class="page-social-panel__heading">
				<p class="eyebrow">Elsewhere</p>
				<h2 id="about-social-title">Follow the work.</h2>
			</div>
			<SocialLinks className="page-social-links" />
		</section>
	</div>
</RefractBaseLayout>
