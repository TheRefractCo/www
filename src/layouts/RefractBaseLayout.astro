---
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import Analytics from '../components/Analytics.astro';
import BaseHead from '../components/BaseHead.astro';
import RefractFooter from '../components/RefractFooter.astro';
import RefractHeader from '../components/RefractHeader.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	pageClass?: string;
	footerVariant?: 'default' | 'compact';
}

const { title, description, image, pageClass, footerVariant = 'default' } = Astro.props;

const refractPageTransition = {
	forwards: {
		old: [
			{
				name: 'refract-fade-out',
				duration: '220ms',
				easing: 'ease-out',
				fillMode: 'both',
			},
			{
				name: 'refract-nudge-out-left',
				duration: '260ms',
				easing: 'cubic-bezier(0.4, 0, 1, 1)',
				fillMode: 'both',
			},
		],
		new: [
			{
				name: 'refract-fade-in',
				duration: '420ms',
				easing: 'ease-out',
				fillMode: 'both',
			},
			{
				name: 'refract-nudge-in-right',
				delay: '90ms',
				duration: '330ms',
				easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
				fillMode: 'both',
			},
		],
	},
	backwards: {
		old: [
			{
				name: 'refract-fade-out',
				duration: '220ms',
				easing: 'ease-out',
				fillMode: 'both',
			},
			{
				name: 'refract-nudge-out-right',
				duration: '260ms',
				easing: 'cubic-bezier(0.4, 0, 1, 1)',
				fillMode: 'both',
			},
		],
		new: [
			{
				name: 'refract-fade-in',
				duration: '420ms',
				easing: 'ease-out',
				fillMode: 'both',
			},
			{
				name: 'refract-nudge-in-left',
				delay: '90ms',
				duration: '330ms',
				easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
				fillMode: 'both',
			},
		],
	},
};
---

<!doctype html>
<html lang="en" transition:name="root" transition:animate="none">
	<head>
		<BaseHead title={title} description={description} image={image} />
		<ClientRouter />
	</head>
	<body class={pageClass}>
		<RefractHeader />
		<div transition:animate={refractPageTransition}>
			<main>
				<slot />
			</main>
			<RefractFooter variant={footerVariant} />
		</div>
		<Analytics />
	</body>
</html>

<script>
	import type { TransitionBeforePreparationEvent } from 'astro:transitions/client';

	const headerRouteIndex = (url: URL) => {
		const path = url.pathname.replace(/\/+$/, '') || '/';

		if (path === '/') return 0;
		if (path === '/projects') return 1;
		if (path === '/paper') return 2;
		if (path === '/blog' || path.startsWith('/blog/')) return 3;
		if (path === '/about') return 4;
		if (path === '/contact') return 5;

		return undefined;
	};

	document.addEventListener('astro:before-preparation', (event) => {
		const navigation = event as TransitionBeforePreparationEvent;
		const fromIndex = headerRouteIndex(navigation.from);
		const toIndex = headerRouteIndex(navigation.to);

		if (fromIndex === undefined || toIndex === undefined || fromIndex === toIndex) return;

		navigation.direction = toIndex > fromIndex ? 'forward' : 'back';
	});
</script>

<script>
	const prepareStaggeredHeadings = () => {
		document.querySelectorAll<HTMLHeadingElement>('h1').forEach((heading) => {
			if (heading.dataset.staggeredHeading === 'true') return;

			const accessibleHeading = heading.cloneNode(true) as HTMLHeadingElement;
			accessibleHeading.querySelectorAll('br').forEach((breakElement) => breakElement.replaceWith(' '));
			const accessibleLabel = accessibleHeading.textContent?.replace(/\s+/g, ' ').trim();
			if (!accessibleLabel) return;

			const walker = document.createTreeWalker(heading, NodeFilter.SHOW_TEXT);
			const textNodes: Text[] = [];
			while (walker.nextNode()) textNodes.push(walker.currentNode as Text);

			let wordIndex = 0;
			textNodes.forEach((textNode) => {
				const fragment = document.createDocumentFragment();
				const parts = textNode.textContent?.split(/(\s+)/) ?? [];

				parts.forEach((part) => {
					if (!part || /^\s+$/.test(part)) {
						fragment.append(part);
						return;
					}

					const word = document.createElement('span');
					word.textContent = part;
					word.dataset.staggeredWord = '';
					word.setAttribute('aria-hidden', 'true');
					word.style.setProperty('--word-index', String(wordIndex));
					fragment.append(word);
					wordIndex += 1;
				});

				textNode.replaceWith(fragment);
			});

			heading.setAttribute('aria-label', accessibleLabel);
			heading.dataset.staggeredHeading = 'true';
			heading.classList.add('staggered-heading--ready');
		});
	};

	const windowWithHeadingSetup = window as Window & { refractHeadingSetup?: boolean };
	if (!windowWithHeadingSetup.refractHeadingSetup) {
		document.addEventListener('astro:page-load', prepareStaggeredHeadings);
		windowWithHeadingSetup.refractHeadingSetup = true;
	}
	prepareStaggeredHeadings();
</script>
