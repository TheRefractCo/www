---
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import Analytics from '../components/Analytics.astro';
import BaseHead from '../components/BaseHead.astro';
import LanguageSuggestion from '../components/LanguageSuggestion.astro';
import RefractFooter from '../components/RefractFooter.astro';
import RefractHeader from '../components/RefractHeader.astro';
import { defaultLang } from '../i18n/ui';
import { localeList } from '../i18n/utils';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	pageClass?: string;
	footerVariant?: 'default' | 'compact';
	noIndex?: boolean;
}

const { title, description, image, pageClass, footerVariant = 'default', noIndex = false } = Astro.props;
const pageLocale = Astro.currentLocale ?? defaultLang;

const pageTransition = {
	forwards: {
		old: {
			name: 'refractPageFadeOut',
			duration: '280ms',
			easing: 'cubic-bezier(0.22, 0.61, 0.36, 1)',
			fillMode: 'both',
		},
		new: {
			name: 'refractPageFadeIn',
			duration: '280ms',
			easing: 'cubic-bezier(0.22, 0.61, 0.36, 1)',
			fillMode: 'both',
		},
	},
	backwards: {
		old: {
			name: 'refractPageFadeOutBack',
			duration: '280ms',
			easing: 'cubic-bezier(0.22, 0.61, 0.36, 1)',
			fillMode: 'both',
		},
		new: {
			name: 'refractPageFadeInBack',
			duration: '280ms',
			easing: 'cubic-bezier(0.22, 0.61, 0.36, 1)',
			fillMode: 'both',
		},
	},
};
---

<!doctype html>
	<html lang={pageLocale}>
	<head>
		<BaseHead title={title} description={description} image={image} noIndex={noIndex} />
		<ClientRouter />
	</head>
	<body class={pageClass}>
		<RefractHeader />
		<div class="page-transition-shell" transition:name="refract-content" transition:animate={pageTransition}>
			<main>
				<slot />
			</main>
			<RefractFooter variant={footerVariant} />
		</div>
		<LanguageSuggestion />
		<Analytics />
	</body>
</html>

<style is:global>
	.page-transition-shell {
		width: 100%;
	}

	::view-transition-group(refract-content) {
		animation: none;
	}

	@keyframes refractPageFadeOut {
		from {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}
		to {
			opacity: 0;
			transform: translate3d(-0.9rem, 0, 0);
		}
	}

	@keyframes refractPageFadeIn {
		from {
			opacity: 0;
			transform: translate3d(0.9rem, 0, 0);
		}
		to {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}
	}

	@keyframes refractPageFadeOutBack {
		from {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}
		to {
			opacity: 0;
			transform: translate3d(0.9rem, 0, 0);
		}
	}

	@keyframes refractPageFadeInBack {
		from {
			opacity: 0;
			transform: translate3d(-0.9rem, 0, 0);
		}
		to {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}
	}
</style>

<script define:vars={{ supportedLocaleCodes: localeList }}>
	const prepareStaggeredHeadings = () => {
		document.querySelectorAll<HTMLHeadingElement>('h1').forEach((heading) => {
			if (heading.dataset.staggeredHeading === 'true') return;

			const accessibleHeading = heading.cloneNode(true) as HTMLHeadingElement;
			accessibleHeading.querySelectorAll('br').forEach((breakElement) => breakElement.replaceWith(' '));
			const accessibleLabel = accessibleHeading.textContent?.replace(/\s+/g, ' ').trim();
			if (!accessibleLabel) return;

			const walker = document.createTreeWalker(heading, NodeFilter.SHOW_TEXT);
			const textNodes: Text[] = [];
			while (walker.nextNode()) textNodes.push(walker.currentNode as Text);

			let wordIndex = 0;
			textNodes.forEach((textNode) => {
				const fragment = document.createDocumentFragment();
				const parts = textNode.textContent?.split(/(\s+)/) ?? [];

				parts.forEach((part) => {
					if (!part || /^\s+$/.test(part)) {
						fragment.append(part);
						return;
					}

					const word = document.createElement('span');
					word.textContent = part;
					word.dataset.staggeredWord = '';
					word.setAttribute('aria-hidden', 'true');
					word.style.setProperty('--word-index', String(wordIndex));
					fragment.append(word);
					wordIndex += 1;
				});

				textNode.replaceWith(fragment);
			});

			heading.setAttribute('aria-label', accessibleLabel);
			heading.dataset.staggeredHeading = 'true';
			heading.classList.add('staggered-heading--ready');
		});
	};

	const windowWithHeadingSetup = window as Window & { refractHeadingSetup?: boolean };
	if (!windowWithHeadingSetup.refractHeadingSetup) {
		document.addEventListener('astro:page-load', prepareStaggeredHeadings);
		windowWithHeadingSetup.refractHeadingSetup = true;
	}
	prepareStaggeredHeadings();

	const routeOrder = ['/', '/projects/', '/blog/', '/about/', '/contact/'];
	const logicalPathname = (pathname: string) => {
		const parts = pathname.split('/').filter(Boolean);
		if (supportedLocaleCodes.includes(parts[0])) parts.shift();
		return `/${parts.join('/')}/`.replace('//', '/') || '/';
	};
	const routeIndex = (pathname: string) => {
		const normalized = logicalPathname(pathname).replace(/\/+$/, '') || '/';
		const index = routeOrder.findIndex((route) => {
			const normalizedRoute = route.replace(/\/+$/, '') || '/';
			return normalized === normalizedRoute || (normalizedRoute !== '/' && normalized.startsWith(`${normalizedRoute}/`));
		});
		return index;
	};

	const windowWithTransitionSetup = window as Window & { refractTransitionSetup?: boolean };
	if (!windowWithTransitionSetup.refractTransitionSetup) {
		document.addEventListener('astro:before-preparation', (event) => {
			if (event.navigationType !== 'push') return;
			const fromIndex = routeIndex(event.from.pathname);
			const toIndex = routeIndex(event.to.pathname);
			if (fromIndex < 0 || toIndex < 0 || fromIndex === toIndex) return;
			event.direction = toIndex > fromIndex ? 'forward' : 'back';
		});
		windowWithTransitionSetup.refractTransitionSetup = true;
	}
</script>
