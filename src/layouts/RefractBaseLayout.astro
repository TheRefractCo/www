---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import RefractFooter from '../components/RefractFooter.astro';
import RefractHeader from '../components/RefractHeader.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body>
		<RefractHeader />
		<main>
			<slot />
		</main>
		<RefractFooter />
	</body>
</html>
